{
  "manifest_version": 3,
  "name": "GMGN 热门币监控",
  "version": "0.13.2",
  "description": "监控 GMGN 热门榜，发现前排新代币时提醒并使用 Grok 分析叙事。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "notifications",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://gmgn.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "GMGN 热门币监控",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://gmgn.ai/trend*"],
      "js": ["src/content/loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/shared/*.js",
        "src/content/*.js",
        "src/content/adapters/*.js",
        "src/content/core/*.js",
        "src/content/ui/*.js"
      ],
      "matches": ["https://gmgn.ai/*"]
    }
  ]
}
